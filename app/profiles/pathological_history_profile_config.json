  "rules": [
    {
      "name": "patientName",
      "condition": "true",
      "priority": 1,
      "actions": [
        "data.put('patientName', fhirPath.extractValue(Patient, \"Patient.name.given\"))"
      ]
    },
    {
      "name": "latestEncounterQRWithPathologicalHistory",
      "condition": "true",
      "priority": 3,
      "actions": [
        "data.put('latestEncounterQRWithPathologicalHistory', service.filterResources(availableQuestionnaireResponses, \"QuestionnaireResponse.descendants().where(linkId = 'medical-history' and answer.value.exists()).answer.value.code contains 'pathological-history'\").get(0))"
      ]
    },
    {
      "name": "latestPathologicalHistoryEncounterID",
      "condition": "true",
      "priority": 4,
      "actions": [
        "data.put('latestPathologicalHistoryEncounterID', fhirPath.extractValue(data.get('latestEncounterQRWithPathologicalHistory'), \"QuestionnaireResponse.encounter.reference.substring(10)\"))"
      ]
    },
    {
      "name": "hasPathologicalHistory",
      "condition": "true",
      "priority": 5,
      "actions": [
        "data.put('hasPathologicalHistory', data.get('latestPathologicalHistoryEncounterID') != null && data.get('latestPathologicalHistoryEncounterID') != '')"
      ]
    },
    {
      "name": "chronicDegenerativeDiseases",
      "condition": "true",
      "priority": 2,
      "actions": [
        "data.put('chronicDegenerativeDiseases', service.filterResources(availableConditions, \"Condition.category.coding.code = 'chronic-problem-list-item'\"))"
      ]
    },
    {
      "name": "latestChronicDegenerativeDiseases",
      "condition": "true",
      "priority": 5,
      "actions": [
        "var illnesses = ''; for (var condition: data.get('chronicDegenerativeDiseases')) { if((data.get('latestPathologicalHistoryEncounterID')).equals(fhirPath.extractValue(condition, 'Condition.encounter.reference.substring(10)'))){ illnesses = illnesses + fhirPath.extractValue(condition, 'Condition.code.coding.display') + ', '; }}; data.put('latestChronicDegenerativeDiseases', illnesses.replaceAll(',\\\\s*$', ''));"
      ]
    },
    {
      "name": "displayChronicDegenerativeDiseases",
      "condition": "true",
      "priority": 6,
      "actions": [
