      "priority": 2,
      "actions": [
        "data.put('otherDiseases', service.filterResources(availableConditions, \"Condition.identifier.value = 'other-disease-problem-item'\"))"
      ]
    },
    {
      "name": "latestOtherDiseases",
      "condition": "true",
      "priority": 5,
      "actions": [
        "var otherDiseases = ''; for (var disease: data.get('otherDiseases')) { if((data.get('latestPathologicalHistoryEncounterID')).equals(fhirPath.extractValue(disease, 'Condition.encounter.reference.substring(10)'))){ otherDiseases = otherDiseases + fhirPath.extractValue(disease, 'Condition.note.text') + ', '; }}; data.put('latestOtherDiseases', otherDiseases.replaceAll(',\\\\s*$', ''));"
      ]
    },
    {
      "name": "displayLatestOtherDiseases",
      "condition": "true",
      "priority": 6,
      "actions": [
        "data.put('displayLatestOtherDiseases', (data.get('latestOtherDiseases') != null) && (data.get('latestOtherDiseases') != ''))"
      ]
    }
  ],
